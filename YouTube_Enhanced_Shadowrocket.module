#!name=YouTube 增强去广告 (Shadowrocket 转换版)
#!desc=转换自 IBL3ND Egern-YouTube；Protobuf 广告过滤、后台播放相关功能，需实际测试兼容性
#!author=IBL3ND / conversion
#!homepage=https://github.com/IBL3ND/module

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad - reject
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject

[Script]
youtube-ad-break = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/youtube-request.js,requires-body=true,binary-body=true

youtube-download-response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$,script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/youtube-response.js,requires-body=true,binary-body=true,max-size=0,argument={"nativeDownload":false}

youtube-player-request = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$,script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/youtube-request.js,requires-body=true,binary-body=true,argument={"nativeDownload":false}

youtube-api-response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/youtube-response.js,requires-body=true,binary-body=true,max-size=0,argument={"blockUpload":true,"blockShorts":true,"blockGames":true,"blockVerticalLive":true,"jumpAhead":true,"autoHd":true,"blockStore":true}

youtube-ump-response = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/youtube-response.js,requires-body=true,binary-body=true,max-size=0,argument={"blockGames":true,"blockVerticalLive":true,"jumpAhead":true,"autoHd":true,"blockStore":true}

youtube-init-request = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/youtube-request.js,requires-body=true,binary-body=true

youtube-quality-request = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback,script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/youtube-request.js,requires-body=true,binary-body=true,argument={"autoHd":true}

youtube-log-event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/youtube-request.js,requires-body=true,binary-body=true

youtube-dual-subtitles = type=http-response,pattern=^https:\/\/(?:www|m)\.youtube\.com\/api\/timedtext(?:\?|$),script-path=https://raw.githubusercontent.com/IBL3ND/js/refs/heads/main/YT-CC-ASR-Auto.js,requires-body=true

[MITM]
hostname = %APPEND% *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com, m.youtube.com, -redirector*.googlevideo.com
